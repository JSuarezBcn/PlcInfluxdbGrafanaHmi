<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{3398a9b0-4584-4222-bb2c-ce921e20f8d4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	fbSignalSaw				: FB_FunctionGenerator;
	rSignal1				: LREAL;
	fbSignalSinus1			: FB_FunctionGenerator;
	rSignal2				: LREAL;
	fbDBAutoLog				: FB_PLCDBAutoLogEvt(sNetID:='', tTimeout:=T#5S);
	bAutoLogStart			: BOOL;
	bErrAutoLog				: BOOL;
	aAutoLogStatus			: ARRAY [1..1] OF ST_AutoLogGrpStatus;
	rTrig1					: R_TRIG;
	fTrig2					: F_TRIG;
	bRun					: BOOL;
	bStop					: BOOL;
	timerReset				: TON;
	bErrorInfluxdb			: BOOL;
	iReconexiones			: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbSignalSaw(
	bEnable:= TRUE, 
	fFrequency:= 0.2, 
	fAmplitude:= 10, 
	fOffset:= 0, 
	nDutyCycle:= , 
	eFunction:= E_FunctionType.eSawtooth, 
	rSignal:= rSignal1, 
	bError=> );
	
fbSignalSinus1(
	bEnable:= TRUE, 
	fFrequency:= 0.1, 
	fAmplitude:= 5, 
	fOffset:= 0, 
	nDutyCycle:= , 
	eFunction:= E_FunctionType.eSine, 
	rSignal:= rSignal2, 
	bError=> );

rTrig1(CLK:=bAutoLogStart, Q=> );
fTrig2(CLK:=bAutoLogStart, Q=> );

IF _TaskInfo[1].FirstCycle THEN
	bAutoLogStart := TRUE;  // No se inicializa la variable en la declaracion ya que el bloque trigger no detectaría el cambio
END_IF

// Se usa la salida trigger para generar el mensaje en el log, que solo necesita 1 ciclo
// La activacion del autolog con el método Start() tarda unos ciclos
IF rTrig1.Q THEN
	ADSLOGSTR(msgCtrlMask:= ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, msgFmtStr:= 'Autolog Started %s', strArg:='' );
	bRun := TRUE;
END_IF

IF fTrig2.Q THEN
	ADSLOGSTR(msgCtrlMask:= ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, msgFmtStr:= 'Autolog Stopped %s', strArg:='' );
	bStop := TRUE;
END_IF

IF bRun THEN
	IF fbDBAutoLog.Start() THEN
		bRun := FALSE;
	END_IF
END_IF

// EL método Stop también necesita varios ciclos
IF bStop THEN
	IF fbDBAutoLog.Stop() THEN
		bStop := FALSE;
	END_IF
END_IF

// El método de diagnóstico se puede ejecutar cíclicamente
IF bAutoLogStart THEN
	aAutoLogStatus[1].hAutoLogGrpID := 3;
	fbDBAutoLog.Status(tCheckCycle:=T#3S , pError:=ADR(bErrAutoLog) , pAutoLogGrpStatus:=ADR(aAutoLogStatus) , cbAutoLogGrpStatus:=SIZEOF(aAutologStatus) );
	// Si devuelve aAutoLogStatus[1].hrErrorCode= 16#989103E8 la base de datos InfluxDB está detenida
	IF NOT fbDBAutoLog.bBusy_Status THEN
		bErrorInfluxdb := aAutoLogStatus[1].bError;
	END_IF
END_IF

// En caso de error en la conexion con InfluxDB, resetea la funcion autolog cada 3s y comprueba la conexion 
IF bErrorInfluxdb THEN
	bAutoLogStart := FALSE;
	timerReset(IN:=TRUE , PT:=T#3S);
	IF timerReset.Q THEN
		bAutoLogStart := TRUE;
		IF NOT fbDBAutoLog.bBusy_Status THEN
			iReconexiones := iReconexiones+1;
			timerReset(IN:=FALSE);
			bErrorInfluxdb := aAutoLogStatus[1].bError;
		END_IF
	END_IF
ELSE
	timerReset(IN:=FALSE);	
END_IF


]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>